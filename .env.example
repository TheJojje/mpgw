# Kopiera till .env och fyll i - .env ska ALDRIG committas till git.

APP_ENV=production
APP_DEBUG=false

# MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mpgw
DB_USERNAME=mpgw
DB_PASSWORD=

# App-secret for sodium-kryptering av IMAP-losenord OCH rå e-post
# (raw_emails.raw_headers/raw_body) (32 bytes, base64).
# Generera med: php -r "echo base64_encode(sodium_crypto_secretbox_keygen()), PHP_EOL;"
APP_SECRET_KEY=

# Adminsession
# OBS: config.php failar hart vid boot om APP_ENV=production och
# (APP_DEBUG=true eller SESSION_SECURE=false) - bada maste vara ratt i produktion.
SESSION_NAME=mpgw_admin
SESSION_SECURE=true

# SSO via authentik (OIDC). Lamna OIDC_ISSUER tomt for att stanga av SSO.
# OIDC_ISSUER = authentiks issuer-URL for providern, t.ex.
# https://auth.example.com/application/o/mpgw/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Maste matcha redirect URI i authentik
OIDC_REDIRECT_URI=https://mp.larssons.space/auth/oidc/callback
# Medlemskap kravs for inloggning; admin-gruppen ger ocksa atkomst
OIDC_ACCESS_GROUP=GRP-MPGW-Users
OIDC_ADMIN_GROUP=GRP-MPGW-Admin
# Roll-slugs i users_roles
# Logga ut aven fran authentik (kraver post-logout-URI i providern)
OIDC_SSO_LOGOUT=false
OIDC_POST_LOGOUT_REDIRECT_URI=https://mp.larssons.space/admin/login
OIDC_DEFAULT_ROLE=reader
OIDC_ADMIN_ROLE=administrator

# Larmtrosklar
ALERT_MIN_SAMPLE_SIZE=5
ALERT_MATCH_RATE_DROP_THRESHOLD=0.20

# API
API_DEFAULT_RATE_LIMIT_PER_MINUTE=600

# SMTP for larmutskick (valfritt i MVP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=mpgw@example.com
