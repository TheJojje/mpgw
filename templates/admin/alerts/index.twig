{% extends "layout.twig" %}
{% block content %}
<div class="stack">
    <div class="page-header" style="margin-bottom:0;">
        <div>
            <h1>Larm</h1>
            <p class="page-lead">Saker mpgw upptäckt som kan behöva åtgärdas. Varje larm länkar till mailet det gäller.</p>
        </div>
        {% if can('alerts.manage') and counts.open > 0 %}
            <form method="post" action="/admin/alerts/acknowledge" id="bulk-form" style="margin:0;">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" class="btn"><svg class="ic" aria-hidden="true"><use href="#ic-check"></use></svg> Kvittera markerade</button>
            </form>
        {% endif %}
    </div>

    <div class="table-toolbar" style="margin:0;">
        <div class="seg" role="group" aria-label="Status">
            {% set typeQ = type_filter ? '&type=' ~ type_filter : '' %}
            <a href="/admin/alerts?status=open{{ typeQ }}" class="{{ status_filter == 'open' ? 'on' }}">Öppna<span class="n">{{ counts.open }}</span></a>
            <a href="/admin/alerts?status=acknowledged{{ typeQ }}" class="{{ status_filter == 'acknowledged' ? 'on' }}">Kvitterade<span class="n">{{ counts.acknowledged }}</span></a>
            <a href="/admin/alerts?status=resolved{{ typeQ }}" class="{{ status_filter == 'resolved' ? 'on' }}">Lösta<span class="n">{{ counts.resolved }}</span></a>
            <a href="/admin/alerts?status=all{{ typeQ }}" class="{{ status_filter == 'all' ? 'on' }}">Alla<span class="n">{{ counts.all }}</span></a>
        </div>
        <div class="seg" role="group" aria-label="Typ">
            <a href="/admin/alerts?status={{ status_filter }}" class="{{ not type_filter ? 'on' }}">Alla typer</a>
            {% for key, group in type_groups %}
                <a href="/admin/alerts?status={{ status_filter }}&type={{ key }}" class="{{ type_filter == key ? 'on' }}">{{ group.label }}</a>
            {% endfor %}
        </div>
    </div>

    {% if alerts|length > 0 %}
    <div class="box">
        <table class="table">
            <thead><tr>
                {% if can('alerts.manage') and counts.open > 0 %}<th style="width:44px;"><input class="check" type="checkbox" id="check-all" aria-label="Markera alla"></th>{% endif %}
                <th>Vad har hänt</th><th>Var</th><th>När</th><th>Status</th><th class="col-right">Åtgärd</th>
            </tr></thead>
            <tbody>
            {% for alert in alerts %}
                <tr{% if alert.status == 'resolved' %} style="opacity:.8;"{% endif %}>
                    {% if can('alerts.manage') and counts.open > 0 %}
                    <td>{% if alert.status == 'open' %}<input class="check row-check" type="checkbox" name="ids[]" value="{{ alert.id }}" form="bulk-form" aria-label="Markera larmet {{ alert.title }}">{% endif %}</td>
                    {% endif %}
                    <td class="strong">{{ alert.title }}{% if alert.detail %}<span class="sub">{{ alert.detail }}</span>{% endif %}</td>
                    <td>{% if alert.application_id %}<a class="link" href="/admin/applications/{{ alert.application_id }}">{{ alert.application_name|default('—') }}</a>{% else %}—{% endif %}
                        {% if alert.raw_email_subject %}<span class="sub">{{ alert.raw_email_subject }}</span>{% endif %}</td>
                    <td class="tabular muted">{{ alert.created_at }}</td>
                    <td>{{ status_chip(alert.status == 'open' ? 'danger' : (alert.status == 'acknowledged' ? 'warn' : 'ok'), alert.status == 'open' ? 'Öppet' : (alert.status == 'acknowledged' ? 'Kvitterat' : 'Löst')) }}</td>
                    <td class="col-right">
                        <div class="row-actions">
                            {% if alert.link_url %}<a class="btn btn-small" href="{{ alert.link_url }}">{{ alert.link_label }}</a>{% endif %}
                            {% if can('alerts.manage') %}
                                {% if alert.status == 'open' %}
                                    <form method="post" action="/admin/alerts/{{ alert.id }}/acknowledge" class="inline-form">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <button type="submit" class="btn btn-small">Kvittera</button>
                                    </form>
                                {% elseif alert.status == 'acknowledged' %}
                                    <form method="post" action="/admin/alerts/{{ alert.id }}/resolve" class="inline-form">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <button type="submit" class="btn btn-small">Markera löst</button>
                                    </form>
                                {% endif %}
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="muted" style="margin:-12px 0 0; font-size:13px;">Larm löses automatiskt när orsaken försvinner, till exempel när ett saknat mail kommer tillbaka eller en regel ger full träff vid omparsning.</p>
    {% else %}
        <div class="box">
            {% if status_filter == 'open' and not type_filter %}
                <div class="todo"><div class="dot ok"><svg class="ic" aria-hidden="true"><use href="#ic-check-circle"></use></svg></div>
                    <div class="text"><b>Inga öppna larm – allt fungerar</b><span>Alla applikationer pollas och matchar som förväntat.</span></div></div>
            {% else %}
                <div class="todo"><div class="dot warn"><svg class="ic" aria-hidden="true"><use href="#ic-alert"></use></svg></div>
                    <div class="text"><b>Inga larm matchar filtret</b><span>Prova ett annat filter ovan.</span></div></div>
            {% endif %}
        </div>
    {% endif %}
</div>

<script>
(function () {
    var all = document.getElementById('check-all');
    if (!all) return;
    all.addEventListener('change', function () {
        document.querySelectorAll('.row-check').forEach(function (c) { c.checked = all.checked; });
    });
})();
</script>
{% endblock %}
