{% extends "layout.twig" %}
{% block content %}
<div class="breadcrumb">
    <a href="/admin/api-keys">API-nycklar</a>
    <span class="sep">/</span>
    <span class="current">Ny nyckel</span>
</div>
<h1>Ny API-nyckel</h1>
{% if error %}<p class="error">{{ error }}</p>{% endif %}
<form method="post" action="/admin/api-keys" class="form">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    <label>Konsumentnamn<input type="text" name="consumer_name" required placeholder="t.ex. Bofast — bokningsexport"></label>
    <label>Applikation
        <select name="application_id" required>
            <option value="">Välj applikation…</option>
            {% for application in applications %}
                <option value="{{ application.id }}">{{ application.name }}</option>
            {% endfor %}
        </select>
    </label>
    <p class="hint">Nyckeln kan bara läsa data för den här applikationen.</p>

    <div class="field-group">
        <label style="margin-bottom:2px;">Scopes</label>
        <div class="chip-toggle-group">
            <label class="chip-toggle on">
                <input type="checkbox" name="scopes[]" value="records:read" checked onchange="this.parentElement.classList.toggle('on', this.checked)">
                <svg class="ic check-ic"><use href="#ic-check"></use></svg>records:read
            </label>
            <label class="chip-toggle">
                <input type="checkbox" name="scopes[]" value="records:read:raw" onchange="this.parentElement.classList.toggle('on', this.checked)">
                <svg class="ic check-ic"><use href="#ic-check"></use></svg>records:read:raw
            </label>
            <label class="chip-toggle">
                <input type="checkbox" name="scopes[]" value="templates:read" onchange="this.parentElement.classList.toggle('on', this.checked)">
                <svg class="ic check-ic"><use href="#ic-check"></use></svg>templates:read
            </label>
            <label class="chip-toggle">
                <input type="checkbox" name="scopes[]" value="alerts:read" onchange="this.parentElement.classList.toggle('on', this.checked)">
                <svg class="ic check-ic"><use href="#ic-check"></use></svg>alerts:read
            </label>
        </div>
    </div>

    <label>Rate limit / minut<input type="number" name="rate_limit_per_minute" placeholder="600"></label>
    <p class="hint">Lämna tomt för standardgränsen.</p>
    <button type="submit" class="btn btn-primary">Skapa nyckel</button>
</form>
{% endblock %}
