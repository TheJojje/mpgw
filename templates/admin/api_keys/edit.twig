{% extends "layout.twig" %}
{% block content %}
<div class="breadcrumb">
    <a href="/admin/api-keys">API-nycklar</a>
    <span class="sep">/</span>
    <span class="current">Redigera nyckel</span>
</div>
<h1>Redigera API-nyckel</h1>
{% if error %}<p class="error">{{ error }}</p>{% endif %}
<form method="post" action="/admin/api-keys/{{ key.id }}/edit" class="form">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    <label>Konsumentnamn<input type="text" name="consumer_name" required value="{{ key.consumer_name }}"></label>
    <label>Applikation<input type="text" value="{{ key.application_name|default('—') }}" disabled></label>
    <p class="hint">Applikationen kan inte ändras. Vill du flytta nyckeln till en annan applikation, återkalla den här och skapa en ny.</p>

    {% set scopes = key.scopes|json_decode %}
    <div class="field-group">
        <label style="margin-bottom:2px;">Scopes</label>
        <div class="chip-toggle-group">
            <label class="chip-toggle {{ 'records:read' in scopes ? 'on' : '' }}">
                <input type="checkbox" name="scopes[]" value="records:read" {{ 'records:read' in scopes ? 'checked' : '' }} onchange="this.parentElement.classList.toggle('on', this.checked)">
                <svg class="ic check-ic"><use href="#ic-check"></use></svg>records:read
            </label>
            <label class="chip-toggle {{ 'records:read:raw' in scopes ? 'on' : '' }}">
                <input type="checkbox" name="scopes[]" value="records:read:raw" {{ 'records:read:raw' in scopes ? 'checked' : '' }} onchange="this.parentElement.classList.toggle('on', this.checked)">
                <svg class="ic check-ic"><use href="#ic-check"></use></svg>records:read:raw
            </label>
            <label class="chip-toggle {{ 'templates:read' in scopes ? 'on' : '' }}">
                <input type="checkbox" name="scopes[]" value="templates:read" {{ 'templates:read' in scopes ? 'checked' : '' }} onchange="this.parentElement.classList.toggle('on', this.checked)">
                <svg class="ic check-ic"><use href="#ic-check"></use></svg>templates:read
            </label>
            <label class="chip-toggle {{ 'alerts:read' in scopes ? 'on' : '' }}">
                <input type="checkbox" name="scopes[]" value="alerts:read" {{ 'alerts:read' in scopes ? 'checked' : '' }} onchange="this.parentElement.classList.toggle('on', this.checked)">
                <svg class="ic check-ic"><use href="#ic-check"></use></svg>alerts:read
            </label>
        </div>
    </div>

    <label>Rate limit / minut<input type="number" name="rate_limit_per_minute" value="{{ key.rate_limit_per_minute }}" placeholder="600"></label>
    <p class="hint">Lämna tomt för standardgränsen.</p>
    <button type="submit" class="btn btn-primary">Spara</button>
</form>
{% endblock %}
