{% extends "layout.twig" %}
{% block content %}
<div class="breadcrumb">
    <a href="/admin/emails">Mailhistorik</a>
    <span class="sep">/</span>
    <span class="current">{{ email.subject|default('(inget ämne)') }}</span>
</div>
<div class="page-header">
    <h1>{{ email.subject|default('(inget ämne)') }}</h1>
    {% if record %}
        {{ status_chip(record.status == 'success' ? 'ok' : (record.status == 'partial' ? 'warn' : 'danger'), 'Träffgrad ' ~ (record.match_rate * 100)|round ~ '%') }}
    {% endif %}
    {% if can('emails.manage') %}
        <form method="post" action="/admin/emails/{{ email.uuid }}/reparse" class="inline-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <button type="submit" class="btn btn-small"><svg class="ic"><use href="#ic-history"></use></svg> Parsa om</button>
        </form>
        <form method="post" action="/admin/emails/{{ email.uuid }}/delete" class="inline-form" data-confirm-delete="mailet? Det tas bort permanent tillsammans med extraherade fält och importeras inte igen.">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <button type="submit" class="btn btn-small btn-danger"><svg class="ic"><use href="#ic-trash"></use></svg> Radera</button>
        </form>
    {% endif %}
</div>

<div class="split-card" style="margin-bottom:20px;">
    <div class="split-card-half">
        <h2>Om mailet</h2>
        <dl class="meta-list" style="margin-bottom:0;">
            <dt>Från</dt><dd>{{ email.from_address }}</dd>
            <dt>Skickat</dt><dd class="tabular">{{ sent_at|default('okänt') }}</dd>
            <dt>Importerat</dt><dd class="tabular">{{ email.fetched_at }}</dd>
        </dl>
    </div>
    <div class="split-card-half">
        <h2>Extraherat resultat</h2>
        {% if record %}
            {% if field_matches|length > 0 %}
                <p class="hint" style="margin:-8px 0 12px;">Hovra ett fält för att se var i mailet det extraherades ifrån.</p>
            {% endif %}
            <div class="field-rows" style="border:1px solid var(--border); border-radius:var(--radius-sm);">
            {% for field in fields %}
                {% set m = field_matches[field.field_name] ?? null %}
                {% if m and m.matched and m.char_start is not null %}
                    <div class="field-row" data-field-id="f{{ loop.index0 }}" style="--rule-color: var({{ rule_color_var(loop.index0) }}); --rule-color-tint: var({{ rule_color_var(loop.index0) }}-tint);" tabindex="0">
                        <div class="f-name"><span class="rule-swatch"></span>{{ field.field_name }}</div>
                        <div class="f-value">{{ field.field_value|default('—') }}</div>
                        {{ status_chip('ok', 'Träff') }}
                    </div>
                {% else %}
                    <div class="field-row" style="cursor:default;">
                        <div class="f-name">{{ field.field_name }}</div>
                        <div class="f-value">{{ field.field_value|default('—') }}</div>
                        {{ status_chip(field.matched ? 'ok' : 'danger', field.matched ? 'Träff' : 'Ingen träff') }}
                    </div>
                {% endif %}
            {% endfor %}
            </div>
        {% else %}
            <p class="flash flash-warning" style="margin:0;">Mailet matchade ingen mall.</p>
        {% endif %}
    </div>
</div>

{% if record and record.thread_key %}
<div class="panel" style="margin-bottom:20px; padding:16px 20px;">
    <h2 style="margin-top:0;">Tråd {{ record.thread_state == 'open' ? status_chip('warn', 'Öppen') : status_chip('ok', 'Stängd') }}</h2>
    {% if record.thread_anomaly %}
        <p class="flash flash-warning" style="margin:0 0 12px;">
            {% if record.thread_anomaly == 'close_without_open' %}Det här mailet stänger en tråd som aldrig öppnades (saknas ett mail?).
            {% elseif record.thread_anomaly == 'duplicate_close' %}Tråden var redan stängd när det här mailet kom (dubblett?).
            {% elseif record.thread_anomaly == 'duplicate_open' %}Tråden var redan öppen när det här mailet kom (dubblett?).
            {% else %}{{ record.thread_anomaly }}{% endif %}
        </p>
    {% endif %}
    <table class="table">
        <thead><tr><th>#</th><th>Händelse</th><th>Skickat</th><th>Ämne</th></tr></thead>
        <tbody>
        {% for m in thread_mails %}
            <tr{% if m.uuid != email.uuid %} class="clickable" onclick="window.location='/admin/emails/{{ m.uuid }}'"{% endif %}>
                <td>{{ m.thread_sequence }}</td>
                <td>{{ m.thread_event == 'open' ? 'Öppnar' : 'Stänger' }}{% if m.thread_anomaly %} {{ status_chip('warn', 'Avvikelse') }}{% endif %}{% if m.uuid == email.uuid %} <span class="muted">(det här mailet)</span>{% endif %}</td>
                <td class="tabular muted">{{ m.sent_at|default('okänt') }}</td>
                <td>{{ m.subject|default('(inget ämne)') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<div class="disclosure" id="raw-email-disclosure">
    <button type="button" class="disclosure-toggle" data-disclosure-toggle="raw-email-disclosure">
        <svg class="ic"><use href="#ic-mail"></use></svg>
        Rått mail
        <span class="hint" style="font-weight:400;">— så här såg mailet ut innan normalisering</span>
        <svg class="ic chevron"><use href="#ic-chevron-right"></use></svg>
    </button>
    <div class="disclosure-body">
        <dl class="meta-list" style="margin-bottom:12px;">
            <dt>Skickat</dt><dd class="tabular">{{ sent_header|default(sent_at|default('okänt')) }}</dd>
            <dt>Ämne</dt><dd>{{ email.subject|default('(inget ämne)') }}</dd>
        </dl>
        <pre class="source-text">{%- if field_matches|length > 0 and email.normalized_text -%}
            {%- set cursor = 0 -%}
            {%- set segments = [] -%}
            {%- for field in fields -%}
                {%- set m = field_matches[field.field_name] ?? null -%}
                {%- if m and m.matched and m.char_start is not null -%}
                    {%- set segments = segments|merge([{ start: m.char_start, end: m.char_end, color_index: loop.index0 }]) -%}
                {%- endif -%}
            {%- endfor -%}
            {%- for seg in segments|sort((a, b) => a.start <=> b.start) -%}
                {{- email.normalized_text|slice(cursor, seg.start - cursor) -}}
                <mark data-field-id="f{{ seg.color_index }}" style="--rule-color: var({{ rule_color_var(seg.color_index) }}); --rule-color-tint: var({{ rule_color_var(seg.color_index) }}-tint);" tabindex="0">{{- email.normalized_text|slice(seg.start, seg.end - seg.start) -}}</mark>
                {%- set cursor = seg.end -%}
            {%- endfor -%}
            {{- email.normalized_text|slice(cursor) -}}
        {%- else -%}
            {{- email.raw_body -}}
        {%- endif -%}</pre>
    </div>
</div>

<script>
document.querySelectorAll('[data-confirm-delete]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
        if (!confirm('Radera ' + form.dataset.confirmDelete)) {
            e.preventDefault();
        }
    });
});

document.querySelectorAll('[data-disclosure-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
        var el = document.getElementById(btn.dataset.disclosureToggle);
        if (el) { el.classList.toggle('open'); }
    });
});

// Tvåvägs hover: extraherat-fält-rad <-> markering i rått mail (samma
// färgkopplingskomponent som mallbyggaren, se templates/edit.twig + template-builder.js).
(function () {
    function setHighlight(fieldId, on) {
        document.querySelectorAll('[data-field-id="' + CSS.escape(fieldId) + '"]').forEach(function (el) {
            el.classList.toggle('hl', on);
        });
    }
    document.querySelectorAll('[data-field-id]').forEach(function (el) {
        var id = el.dataset.fieldId;
        el.addEventListener('mouseenter', function () { setHighlight(id, true); });
        el.addEventListener('mouseleave', function () { setHighlight(id, false); });
        el.addEventListener('focus', function () { setHighlight(id, true); });
        el.addEventListener('blur', function () { setHighlight(id, false); });
    });
})();
</script>
{% endblock %}
