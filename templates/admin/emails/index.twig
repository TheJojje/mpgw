{% extends "layout.twig" %}
{% block content %}
{% set qs = (search ? '&q=' ~ search|url_encode : '') ~ (application_filter ? '&application=' ~ application_filter : '') %}
<div class="stack">
    <div class="page-header" style="margin-bottom:0;">
        <div>
            <h1>Mailhistorik</h1>
            <p class="page-lead">Alla mail som importerats, oavsett om de matchade en mall.</p>
        </div>
    </div>

    <div class="table-toolbar" style="margin:0;">
        <form method="get" action="/admin/emails" style="display:contents;">
            <div class="search-field">
                <svg class="ic" aria-hidden="true"><use href="#ic-search"></use></svg>
                <input type="text" name="q" value="{{ search }}" placeholder="Sök på avsändare eller ämne…" aria-label="Sök">
            </div>
            {% if status_filter %}<input type="hidden" name="status" value="{{ status_filter }}">{% endif %}
            <select name="application" onchange="this.form.submit()" aria-label="Applikation">
                <option value="">Alla applikationer</option>
                {% for application in applications %}
                    <option value="{{ application.id }}" {{ application_filter == application.id ? 'selected' : '' }}>{{ application.name }}</option>
                {% endfor %}
            </select>
        </form>
        <div class="seg" role="group" aria-label="Status">
            <a href="/admin/emails?{{ qs|trim('&', 'left') }}" class="{{ not status_filter ? 'on' }}">Alla<span class="n">{{ counts.total|default(0) }}</span></a>
            <a href="/admin/emails?status=success{{ qs }}" class="{{ status_filter == 'success' ? 'on' }}">Matchade<span class="n">{{ counts.success|default(0) }}</span></a>
            <a href="/admin/emails?status=partial{{ qs }}" class="{{ status_filter == 'partial' ? 'on' }}">Delvis<span class="n">{{ counts.partial|default(0) }}</span></a>
            <a href="/admin/emails?status=failed{{ qs }}" class="{{ status_filter == 'failed' ? 'on' }}">Ej matchade<span class="n">{{ counts.failed|default(0) }}</span></a>
            <a href="/admin/emails?status=anomaly{{ qs }}" class="{{ status_filter == 'anomaly' ? 'on' }}">Med avvikelse<span class="n">{{ counts.anomaly|default(0) }}</span></a>
        </div>
        {% if search or application_filter %}
            <a class="link toolbar-clear" href="/admin/emails{{ status_filter ? '?status=' ~ status_filter : '' }}">Rensa filter</a>
        {% endif %}
        <span class="toolbar-count">Visar {{ emails|length }} mail</span>
    </div>

    {% if emails|length > 0 %}
    <div class="box">
        <table class="table">
            <thead><tr><th>Skickat</th><th>Ämne</th><th>Tråd</th><th>Status</th><th>Importerat</th>{% if can('emails.manage') %}<th></th>{% endif %}</tr></thead>
            <tbody>
            {% for email in emails %}
                <tr class="clickable" onclick="window.location='/admin/emails/{{ email.uuid }}'">
                    <td class="tabular">{{ email.sent_at|default('okänt') }}</td>
                    <td class="strong"><a href="/admin/emails/{{ email.uuid }}" style="text-decoration:none;">{{ email.subject|default('(inget ämne)') }}</a><span class="sub">{{ email.from_address }}</span></td>
                    <td>
                        {% if email.thread_key %}
                            <span class="pill {{ email.thread_event }}">{{ email.thread_event == 'open' ? 'Öppnar' : 'Stänger' }}</span>
                            <span class="muted tabular" style="font-size:12.5px;">tråd {{ email.thread_no }} · {{ email.thread_size }} mail</span>
                            {% if email.thread_anomaly %}{{ status_chip('warn', 'Avvikelse') }}{% endif %}
                        {% else %}<span class="muted">—</span>{% endif %}
                    </td>
                    <td>
                        {% if email.status == 'success' %}{{ status_chip('ok', 'Matchad') }}
                        {% elseif email.status == 'partial' %}{{ status_chip('warn', 'Delvis matchad') }}
                        {% else %}{{ status_chip('danger', 'Ej matchad') }}{% endif %}
                    </td>
                    <td class="tabular muted">{{ email.fetched_at }}</td>
                    {% if can('emails.manage') %}
                    <td class="row-actions" onclick="event.stopPropagation()">
                        <form method="post" action="/admin/emails/{{ email.uuid }}/delete" class="inline-form" data-confirm-delete="mailet? Det tas bort permanent tillsammans med extraherade fält och importeras inte igen.">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <button type="submit" class="btn btn-small btn-icon-only btn-danger" title="Radera" aria-label="Radera"><svg class="ic" aria-hidden="true"><use href="#ic-trash"></use></svg></button>
                        </form>
                    </td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="box">
        <div class="empty-state">
            <div class="empty-icon"><svg class="ic-lg"><use href="#ic-inbox-empty"></use></svg></div>
            <h3>{{ (search or status_filter or application_filter) ? 'Inga mail matchar sökningen' : 'Inga mail hämtade än' }}</h3>
            <p>{{ (search or status_filter or application_filter) ? 'Justera sökningen eller filtret ovan.' : 'Kontrollera att minst en mailbox är konfigurerad och aktiv.' }}</p>
            {% if not search and not status_filter and not application_filter %}<a class="btn" href="/admin/applications">Visa applikationer</a>{% endif %}
        </div>
    </div>
    {% endif %}
</div>

<script>
document.querySelectorAll('[data-confirm-delete]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
        if (!confirm('Radera ' + form.dataset.confirmDelete)) {
            e.preventDefault();
        }
    });
});
</script>
{% endblock %}
