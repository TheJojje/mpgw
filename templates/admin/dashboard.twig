{% extends "layout.twig" %}
{% block content %}
<div class="stack">
    <div class="page-header" style="margin-bottom:0;">
        <div>
            <h1>Översikt</h1>
            <p class="page-lead">Läget just nu. Överst det som behöver din uppmärksamhet.</p>
        </div>
    </div>

    <section aria-labelledby="h-todo">
        <div class="sec-head">
            <h2 id="h-todo">Behöver uppmärksamhet</h2>
            {% if open_alerts_count > 0 %}{{ status_chip('danger', open_alerts_count ~ ' öppna') }}{% endif %}
            <a class="link right" href="/admin/alerts">Alla larm</a>
        </div>
        <div class="box">
            {% for alert in todo %}
                <div class="todo">
                    <div class="dot warn"><svg class="ic" aria-hidden="true"><use href="#ic-alert"></use></svg></div>
                    <div class="text">
                        <b>{{ alert.title }}</b>
                        <span>{% if alert.application_name %}{{ alert.application_name }} · {% endif %}{{ alert.detail }}</span>
                    </div>
                    {% if alert.link_url %}<a class="btn btn-small" href="{{ alert.link_url }}">{{ alert.link_label }}</a>{% endif %}
                </div>
            {% else %}
                <div class="todo">
                    <div class="dot ok"><svg class="ic" aria-hidden="true"><use href="#ic-check-circle"></use></svg></div>
                    <div class="text"><b>Allt fungerar</b><span>Inga öppna larm och inga brevlådor som går fel.</span></div>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="strip" aria-label="Nyckeltal">
        <div class="cell"><span class="k">Mail senaste 24 timmarna</span><span class="v">{{ mails_24h }}</span><span class="d">{{ partial_24h > 0 ? 'varav ' ~ partial_24h ~ ' delvis matchat' : 'inga delvis matchade' }}</span></div>
        <div class="cell"><span class="k">Träffgrad (7 dagar)</span><span class="v">{{ match_rate_7d is not null ? match_rate_7d ~ ' %' : '—' }}</span><span class="d">{{ records_7d > 0 ? success_7d ~ ' av ' ~ records_7d ~ ' mail fullt matchade' : 'inga mail ännu' }}</span></div>
        <div class="cell"><span class="k">Öppna trådar</span><span class="v">{{ open_threads }}</span><span class="d">{{ closed_threads }} stängda · {{ anomalies }} avvikelser</span></div>
        <div class="cell"><span class="k">Senast pollad</span><span class="v">{{ last_polled ? last_polled|slice(11, 5) : '—' }}</span><span class="d">{{ last_polled ? last_polled|slice(0, 10) ~ ' · ' : '' }}{{ mailbox_count }} {{ mailbox_count == 1 ? 'mailbox' : 'mailboxar' }}</span></div>
    </section>

    <div class="grid-2">
        <section aria-labelledby="h-recent">
            <div class="sec-head"><h2 id="h-recent">Senaste mail</h2><a class="link right" href="/admin/emails">Visa alla</a></div>
            <div class="box">
                {% if recent_emails|length > 0 %}
                <table class="table">
                    <thead><tr><th>Skickat</th><th>Ämne</th><th>Status</th></tr></thead>
                    <tbody>
                    {% for email in recent_emails %}
                        <tr class="clickable" onclick="window.location='/admin/emails/{{ email.uuid }}'">
                            <td class="tabular muted">{{ email.sent_at|default('okänt') }}</td>
                            <td class="strong"><a href="/admin/emails/{{ email.uuid }}" style="text-decoration:none;">{{ email.subject|default('(inget ämne)') }}</a><span class="sub">{{ email.from_address }}</span></td>
                            <td>{% if email.match_status == 'success' %}{{ status_chip('ok', 'Matchad') }}{% elseif email.match_status == 'partial' %}{{ status_chip('warn', 'Delvis') }}{% else %}{{ status_chip('danger', 'Ej matchad') }}{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% else %}
                    <div class="empty-state"><h3>Inga mail hämtade än</h3><p>Kontrollera att minst en mailbox är konfigurerad och aktiv.</p></div>
                {% endif %}
            </div>
        </section>

        <section aria-labelledby="h-apps">
            <div class="sec-head"><h2 id="h-apps">Applikationer</h2><a class="link right" href="/admin/applications">Hantera</a></div>
            <div class="box">
                <table class="table">
                    <thead><tr><th>Namn</th><th>Hälsa</th><th class="col-right">Mail 30 d</th></tr></thead>
                    <tbody>
                    {% for app in applications %}
                        <tr class="clickable" onclick="window.location='/admin/applications/{{ app.id }}'">
                            <td class="strong"><a href="/admin/applications/{{ app.id }}" style="text-decoration:none;">{{ app.name }}</a><span class="sub">{{ app.mailbox_count }} {{ app.mailbox_count == 1 ? 'mailbox' : 'mailboxar' }} · {{ app.template_count }} {{ app.template_count == 1 ? 'mall' : 'mallar' }} · trådar {{ app.threads_on ? 'på' : 'av' }}</span></td>
                            <td>{% if app.mailbox_error %}{{ status_chip('danger', 'Mailbox fel') }}{% elseif app.open_alerts > 0 %}{{ status_chip('warn', app.open_alerts ~ ' larm') }}{% else %}{{ status_chip('ok', 'Allt fungerar') }}{% endif %}</td>
                            <td class="col-right tabular">{{ app.mails30 }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="muted">Inga applikationer.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
{% endblock %}
