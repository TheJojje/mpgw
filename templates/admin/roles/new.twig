{% extends "layout.twig" %}
{% block content %}
<div class="breadcrumb">
    <a href="/admin/roles">Roller</a>
    <span class="sep">/</span>
    <span class="current">Ny roll</span>
</div>
<h1>Ny roll</h1>

{% if error %}<p class="error">{{ error }}</p>{% endif %}

<div class="form-panel">
    <form method="post" action="/admin/roles" class="form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label>Namn<input type="text" name="name" required placeholder="t.ex. Redigerare"></label>
        <label>Beskrivning<textarea name="description" rows="2"></textarea></label>

        <fieldset>
            <legend>Rättigheter</legend>
            <table class="permission-matrix">
                <thead><tr><th>Modul</th><th>Rättigheter</th></tr></thead>
                <tbody>
                {% for module, permissions in permission_groups %}
                <tr>
                    <td class="module-name">{{ module }}</td>
                    <td>
                        <div class="permission-checks">
                            {% for permission in permissions %}
                            <label>
                                <input type="checkbox" name="permission_ids[]" value="{{ permission.id }}">
                                {{ permission.name }}
                            </label>
                            {% endfor %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </fieldset>

        <div>
            <button type="submit" class="btn btn-primary">Skapa roll</button>
            <a class="btn" href="/admin/roles">Avbryt</a>
        </div>
    </form>
</div>
{% endblock %}
