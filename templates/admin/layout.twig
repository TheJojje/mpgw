<!doctype html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Mail Parser Gateway{% endblock %}</title>
    <link rel="icon" href="/assets/favicon.png">
    <link rel="stylesheet" href="/assets/css/admin.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.14.5/sweetalert2.all.min.js" integrity="sha512-m4zOGknNg3h+mK09EizkXi9Nf7B3zwsN9ow+YkYIPZoA6iX2vSzLezg4FnW0Q6Z1CPaJdwgUFQ3WSAUC4E/5Hg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="ic-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></symbol>
    <symbol id="ic-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8L6 18M18 6l1.8-1.8"/></symbol>
    <symbol id="ic-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></symbol>
    <symbol id="ic-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></symbol>
    <symbol id="ic-alert" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16h.01"/></symbol>
    <symbol id="ic-key" viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.6 12.4L20 3M16.5 6.5l3 3M13.5 9.5l2.5 2.5"/></symbol>
    <symbol id="ic-logout" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></symbol>
    <symbol id="ic-lightning" viewBox="0 0 24 24"><path d="M13 2L4 14h6l-1 8 9-12h-6z"/></symbol>
    <symbol id="ic-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></symbol>
    <symbol id="ic-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="ic-chevron-right" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></symbol>
    <symbol id="ic-inbox-empty" viewBox="0 0 24 24"><path d="M4 13V6a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v7"/><path d="M4 13h4.5l1.2 2.4a1 1 0 0 0 .9.6h2.8a1 1 0 0 0 .9-.6L15.5 13H20"/><path d="M4 13v5a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-5"/></symbol>
    <symbol id="ic-check-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.2l2.3 2.3 4.8-5"/></symbol>
    <symbol id="ic-eye" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="ic-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 5.2A9.6 9.6 0 0 1 12 5c6.5 0 10 7 10 7a15.6 15.6 0 0 1-4 5M6.2 6.2C3.5 8 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 3.4-.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></symbol>
    <symbol id="ic-copy" viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></symbol>
    <symbol id="ic-check" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></symbol>
    <symbol id="ic-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></symbol>
    <symbol id="ic-server" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/></symbol>
    <symbol id="ic-edit" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></symbol>
    <symbol id="ic-trash" viewBox="0 0 24 24"><path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/></symbol>
    <symbol id="ic-external" viewBox="0 0 24 24"><path d="M14 4h6v6"/><path d="M20 4L10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></symbol>
    <symbol id="ic-arrow-right" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></symbol>
    <symbol id="ic-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><path d="M12 7h.01"/></symbol>
    <symbol id="ic-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c0-3.3 2.5-5.5 5.5-5.5s5.5 2.2 5.5 5.5"/><circle cx="17" cy="9" r="2.6"/><path d="M15.8 14.3c2.4.3 4.2 2.3 4.2 5.2"/></symbol>
    <symbol id="ic-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></symbol>
    <symbol id="ic-history" viewBox="0 0 24 24"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2"/><path d="M5 5l-1.5 2.5M19 5l1.5 2.5"/></symbol>
  </defs>
</svg>

<div class="shell">
    <header class="topbar panel">
        <a class="brand" href="/admin">
            <div class="brand-mark">MP</div>
            <div class="brand-text">
                <div class="name">Mail Parser Gateway</div>
                <div class="sub">mpgw</div>
            </div>
        </a>

        <div class="topbar-right">
            <button class="icon-btn theme-toggle" id="themeToggle" type="button" title="Växla tema" aria-label="Växla mellan ljust och mörkt läge">
                <svg class="ic ic-moon"><use href="#ic-moon"></use></svg>
                <svg class="ic ic-sun"><use href="#ic-sun"></use></svg>
            </button>
            <form method="post" action="/admin/logout" class="logout-form">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit"><svg class="ic"><use href="#ic-logout"></use></svg> Logga ut</button>
            </form>
        </div>
    </header>

    <div class="body-row">
        <nav class="sidebar panel">
            {% if current_user %}
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">{{ current_user.name|slice(0, 1)|upper }}</div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">{{ current_user.name }}</div>
                    <div class="sidebar-user-role">{{ current_user.role_names|join(', ')|default('Ingen roll', true) }}</div>
                </div>
            </div>
            {% endif %}

            <div class="sidebar-section">Översikt</div>
            <a href="/admin" class="nav-link-item{% if current_path == '/admin' %} active{% endif %}">
                <svg class="ic"><use href="#ic-lightning"></use></svg> Översikt
            </a>
            {% if can('applications.view') %}
            <a href="/admin/applications" class="nav-link-item{% if current_path starts with '/admin/applications' %} active{% endif %}">
                <svg class="ic"><use href="#ic-grid"></use></svg> Applikationer
            </a>
            {% endif %}
            {% if can('emails.view') %}
            <a href="/admin/emails" class="nav-link-item{% if current_path starts with '/admin/emails' %} active{% endif %}">
                <svg class="ic"><use href="#ic-mail"></use></svg> Mailhistorik
            </a>
            {% endif %}
            {% if can('alerts.view') %}
            <a href="/admin/alerts" class="nav-link-item{% if current_path starts with '/admin/alerts' %} active{% endif %}">
                <svg class="ic"><use href="#ic-alert"></use></svg> Larm
                {% if sidebar_open_alerts_count > 0 %}<span class="count-badge">{{ sidebar_open_alerts_count }}</span>{% endif %}
            </a>
            {% endif %}
            {% if can('api_keys.view') %}
            <a href="/admin/api-keys" class="nav-link-item{% if current_path starts with '/admin/api-keys' %} active{% endif %}">
                <svg class="ic"><use href="#ic-key"></use></svg> API-nycklar
            </a>
            {% endif %}
            <a href="/admin/help" class="nav-link-item{% if current_path starts with '/admin/help' %} active{% endif %}">
                <svg class="ic"><use href="#ic-info"></use></svg> Hjälp &amp; API-dokumentation
            </a>

            {% if can('users.view') or can('roles.view') or can('logs.view') %}
            <div class="sidebar-section">Administration</div>
            {% endif %}
            {% if can('users.view') %}
            <a href="/admin/users" class="nav-link-item{% if current_path starts with '/admin/users' %} active{% endif %}">
                <svg class="ic"><use href="#ic-users"></use></svg> Användare
            </a>
            {% endif %}
            {% if can('roles.view') %}
            <a href="/admin/roles" class="nav-link-item{% if current_path starts with '/admin/roles' %} active{% endif %}">
                <svg class="ic"><use href="#ic-shield"></use></svg> Roller
            </a>
            {% endif %}
            {% if can('logs.view') %}
            <a href="/admin/logs" class="nav-link-item{% if current_path starts with '/admin/logs' %} active{% endif %}">
                <svg class="ic"><use href="#ic-history"></use></svg> Logg
            </a>
            {% endif %}
        </nav>

        <main class="content">
            {% block content %}{% endblock %}
        </main>
    </div>
</div>

<script>
  // Toast-notiser (SweetAlert2) for skapa/andra/ta bort, nere i hoger hörn.
  // window.mpgwToast(type, text) kan anropas fran sidspecifik JS (t.ex.
  // template-builder.js efter ett AJAX-anrop). Server-satta flash-meddelanden
  // (Support\FlashMessage, satta innan en redirect) visas automatiskt har.
  window.mpgwToast = function (type, text) {
    if (typeof Swal === 'undefined') return;
    Swal.fire({
      toast: true,
      position: 'bottom-end',
      icon: type === 'error' ? 'error' : 'success',
      title: text,
      showConfirmButton: false,
      timer: 4000,
      timerProgressBar: true,
      customClass: { popup: 'mpgw-toast' },
      didOpen: function (el) {
        el.addEventListener('mouseenter', Swal.stopTimer);
        el.addEventListener('mouseleave', Swal.resumeTimer);
      },
    });
  };

  (function () {
    var flashMessages = {{ flash_messages|default([])|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
    flashMessages.forEach(function (message) {
      window.mpgwToast(message.type, message.text);
    });

    // Fortsatt-toast for AJAX-flöden som gör window.location.reload() direkt
    // efter en lyckad spara/ta bort (t.ex. mallbyggaren) - en toast hinner
    // inte synas fore reload, sa den mellanlagras har och visas efter att
    // sidan laddat om. Se template-builder.js.
    try {
      var pending = sessionStorage.getItem('mpgw-pending-toast');
      if (pending) {
        sessionStorage.removeItem('mpgw-pending-toast');
        var parsed = JSON.parse(pending);
        window.mpgwToast(parsed.type, parsed.text);
      }
    } catch (e) {}
  })();

  (function () {
    var root = document.documentElement;
    var toggle = document.getElementById('themeToggle');
    var STORAGE_KEY = 'mpgw-theme';

    function apply(mode) {
      if (mode === 'dark') {
        root.setAttribute('data-theme', 'dark');
      } else {
        root.removeAttribute('data-theme');
      }
    }

    var saved = null;
    try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) {}

    if (saved === 'dark' || saved === 'light') {
      apply(saved);
    } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
      apply('dark');
    }

    toggle.addEventListener('click', function () {
      var isDark = root.getAttribute('data-theme') === 'dark';
      var next = isDark ? 'light' : 'dark';
      apply(next);
      try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
    });
  })();

  // Visa/dölj-toggle för lösenordsfält - delegerad lyssnare sa den fungerar
  // för alla [data-toggle-pw]-knappar oavsett vilken sida som renderas.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-toggle-pw]');
    if (!btn) return;
    var input = document.getElementById(btn.dataset.togglePw);
    if (!input) return;
    var showing = input.type === 'text';
    input.type = showing ? 'password' : 'text';
    btn.innerHTML = '<svg class="ic"><use href="#ic-' + (showing ? 'eye' : 'eye-off') + '"></use></svg>';
  });

  // Visa/dölj-toggle för maskerade API-nyckel-prefix i loggvyerna (se
  // ViewRenderer::renderMaskedKey) - samma delegerade monster som ovan.
  // Visar bara key_prefix (redan klartext i databasen) - aldrig den
  // hemliga nyckeln, som inte finns lagrad nagonstans efter skapande.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.masked-key-toggle');
    if (!btn) return;
    var wrap = btn.closest('.masked-key');
    var valueEl = wrap && wrap.querySelector('.masked-key-value');
    if (!wrap || !valueEl) return;
    var showing = valueEl.textContent === wrap.dataset.full;
    valueEl.textContent = showing ? wrap.dataset.masked : wrap.dataset.full;
    btn.innerHTML = '<svg class="ic"><use href="#ic-' + (showing ? 'eye' : 'eye-off') + '"></use></svg>';
  });
</script>
</body>
</html>
